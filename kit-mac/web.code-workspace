{
  "folders": [
    {
      "name": "Desenvolvimento Web (PHP & MariaDB)",
      "path": "projetos/web"
    }
  ],
  "settings": {
    "update.mode": "none",
    "extensions.autoUpdate": false,
    "extensions.autoCheckUpdates": false,
    "telemetry.telemetryLevel": "off",
    "git.autofetch": false,
    "editor.inlineSuggest.enabled": false,
    "github.copilot.enable": {
      "*": false
    },
    "chat.commandCenter.enabled": false,
    "php.validate.executablePath": "/opt/homebrew/bin/php",
    "intelephense.environment.phpVersion": "8.4",
    "sqltools.useNodeRuntime": true,
    "sqltools.connections": [
      {
        "name": "Laboratório (MariaDB)",
        "dialect": "MySQL",
        "server": "127.0.0.1",
        "port": 3307,
        "database": "aulas",
        "username": "aluno",
        "password": "aluno",
        "connectString": "mysql://aluno:aluno@127.0.0.1:3307/aulas",
        "isActive": true
      }
    ],
    "terminal.integrated.env.osx": {
      "PATH": "/opt/homebrew/opt/mariadb@11.4/bin:/opt/homebrew/bin:${env:PATH}",
      "DB_HOST": "127.0.0.1",
      "DB_PORT": "3307",
      "DB_NAME": "aulas",
      "DB_USER": "aluno",
      "DB_PASSWORD": "aluno"
    }
  }
}
