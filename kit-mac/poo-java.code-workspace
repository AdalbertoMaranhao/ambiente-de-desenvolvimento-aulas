{
  "folders": [
    {
      "name": "POO com Java (Adoptium JDK 25 & SQLite)",
      "path": "projetos/java"
    }
  ],
  "settings": {
    "update.mode": "none",
    "extensions.autoUpdate": false,
    "extensions.autoCheckUpdates": false,
    "telemetry.telemetryLevel": "off",
    "git.autofetch": false,
    "editor.inlineSuggest.enabled": false,
    "github.copilot.enable": {
      "*": false
    },
    "chat.commandCenter.enabled": false,
    "chat.disableAIFeatures": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.wordWrap": "on",
    "errorlens.enabled": true,
    "java.jdt.ls.java.home": "/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home",
    "java.configuration.runtimes": [
      {
        "name": "JavaSE-25",
        "path": "/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home",
        "default": true
      }
    ],
    "java.project.referencedLibraries": [
      "dependencias/java/*.jar"
    ],
    "workbench.editorAssociations": {
      "*.db": "sqlite-viewer.view"
    },
    "terminal.integrated.env.osx": {
      "PATH": "/opt/homebrew/opt/openjdk@25/bin:${env:PATH}",
      "JAVA_HOME": "/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home"
    }
  }
}
