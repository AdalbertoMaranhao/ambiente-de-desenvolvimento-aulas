{
  "name": "🌐 Web (PHP 8.4 & MariaDB)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql"
      ],
      "settings": {
        "editor.inlineSuggest.enabled": false,
        "github.copilot.enable": {
          "*": false
        },
        "chat.commandCenter.enabled": false,
        "php.validate.executablePath": "/usr/local/bin/php",
        "intelephense.environment.phpVersion": "8.4",
        "sqltools.useNodeRuntime": true,
        "sqltools.connections": [
          {
            "name": "Laboratório (MariaDB)",
            "dialect": "MySQL",
            "server": "127.0.0.1",
            "port": 3307,
            "database": "aulas",
            "username": "aluno",
            "password": "aluno",
            "connectString": "mysql://aluno:aluno@127.0.0.1:3307/aulas",
            "isActive": true
          }
        ]
      }
    }
  },
  "remoteEnv": {
    "DB_HOST": "127.0.0.1",
    "DB_PORT": "3307",
    "DB_NAME": "aulas",
    "DB_USER": "aluno",
    "DB_PASSWORD": "aluno"
  },
  "forwardPorts": [3307, 8080],
  "postStartCommand": "/usr/local/bin/init-db.sh",
  "containerUser": "root"
}
